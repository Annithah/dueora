// GENERATED by scripts/postgres-migration.mjs from ../schema.prisma — do not edit by hand.
// DueOra data model.
//
// Conventions (see DECISIONS.md D1 and D6):
// - Calendar dates without time (due dates, paid-on) are ISO strings "YYYY-MM-DD".
//   They sort correctly as text and can never be shifted by a timezone.
// - Money is always US dollars as integer cents (amountCents). Never floats, no other currency.
// - Every business table carries workspaceId; services always filter by it.
// - Json columns have no DB default (Prisma emits invalid SQLite for them); the
//   application always sets them (see src/db/defaults.ts).
// - This file targets SQLite. scripts/postgres-migration.mjs derives the optional
//   PostgreSQL schema from it.

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  COMPANY
  PERSONAL
}

enum Role {
  ADMIN
  FINANCE
  VIEWER
}

enum FrequencyUnit {
  WEEK
  MONTH
  YEAR
  ONCE
}

enum BillStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  CASH
  OTHER
}

enum NotificationType {
  REMINDER
  DUE_TODAY
  OVERDUE
  PAYMENT_RECORDED
  DIGEST
  TRIAL_ENDING
  AUTO_RENEW_NOTICE
  PRICE_CHANGE
  BUDGET_ALERT
  WEEKLY_DIGEST
  MONTHLY_SUMMARY
  TEAM
  SYSTEM
}

enum AiRole {
  USER
  ASSISTANT
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  /// UI and message language: en | fr | rw
  locale          String    @default("en")
  /// Set when the account is deleted; personal data is erased at the same time.
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships       Membership[]
  refreshTokens     RefreshToken[]
  emailTokens       EmailToken[]
  deviceTokens      DeviceToken[]
  notificationPrefs NotificationPreference[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  invitesSent       Invite[]
  snoozes           ReminderSnooze[]
  feedback          Feedback[]
  aiConversations   AiConversation[]
  companyAccess     CompanyAccess[]
}

model Workspace {
  id                     String        @id @default(cuid())
  name                   String
  type                   WorkspaceType @default(COMPANY)
  /// IANA timezone; "today" for this workspace is always computed here.
  timezone               String        @default("UTC")
  /// Local hour (0–23) at which daily reminders go out.
  reminderHour           Int           @default(9)
  /// Quiet hours as minutes after local midnight (e.g. 1320 = 22:00). Both null = no quiet hours.
  quietHoursStart        Int?
  quietHoursEnd          Int?
  /// Default reminder offsets in days (JSON int[]; negative = after due date).
  defaultReminderOffsets Json
  /// ADMIN can switch DueOra AI off for the whole workspace.
  aiEnabled              Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  memberships       Membership[]
  companies         Company[]
  categories        Category[]
  bills             Bill[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  auditLogs         AuditLog[]
  invites           Invite[]
  reminderRuns      WorkspaceReminderRun[]
  budgets           Budget[]
  aiMemories        AiMemory[]
  aiConversations   AiConversation[]
  aiUsage           AiUsage[]
  aiInsights        AiInsight[]
  companyAccess     CompanyAccess[]
}

model Membership {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String
  role         Role     @default(VIEWER)
  /// Access to every company (current and future) with `role`. When false, CompanyAccess lists them.
  allCompanies Boolean  @default(true)
  createdAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model Invite {
  id            String    @id @default(cuid())
  workspaceId   String
  email         String
  role          Role      @default(VIEWER)
  /// Same meaning as Membership.allCompanies.
  allCompanies  Boolean   @default(true)
  /// JSON [{ companyId, role }] used when allCompanies is false.
  companyAccess Json?
  /// SHA-256 of the invite token sent by email.
  tokenHash     String    @unique
  invitedById   String
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  /// SHA-256 of the opaque refresh token; the raw token is never stored.
  tokenHash    String    @unique
  /// All rotations of one login share a family; reuse of a rotated token revokes the family.
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  purpose   EmailTokenPurpose
  /// SHA-256 of the 6-digit code.
  codeHash  String
  attempts  Int               @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// A company inside a workspace. Every bill belongs to exactly one.
model Company {
  id                 String    @id @default(cuid())
  workspaceId        String
  name               String
  /// Initials shown in chips and avatars (e.g. "AN"); derived from the name when empty.
  shortName          String?
  color              String    @default("#0F5C5C")
  description        String?
  /// JSON int[] of default reminder offsets for new bills; null = the workspace default.
  reminderOffsets    Json?
  /// Local hour (0–23) for this company's reminders; null = the workspace reminder hour.
  reminderHour       Int?
  /// Optional monthly budget, US dollars in cents.
  monthlyBudgetCents Int?
  /// Set when a company with bills is "deleted": hidden from pickers, history kept.
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bills     Bill[]
  access    CompanyAccess[]

  @@unique([workspaceId, name])
}

/// Which companies a member (not an admin, not "all companies") can see, and their role in each.
model CompanyAccess {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  companyId   String
  /// FINANCE or VIEWER
  role        Role
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([workspaceId, userId])
}

model Category {
  id          String   @id @default(cuid())
  /// Null for the built-in defaults shared by every workspace.
  workspaceId String?
  name        String
  icon        String
  color       String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bills     Bill[]
  budgets   Budget[]

  @@unique([workspaceId, name])
}

model Bill {
  id                   String         @id @default(cuid())
  workspaceId          String
  companyId            String
  categoryId           String
  name                 String
  provider             String?
  description          String?
  /// AES-256-GCM ciphertext of the account reference (license key, account number, ...). See src/lib/secretBox.ts.
  accountRefEncrypted  String?
  /// Last 4 characters, for the masked display "••••••4F7A".
  accountRefLast4      String?
  /// HMAC-SHA256 of the normalised key, for exact-match search without decrypting.
  accountRefHash       String?
  /// US dollars, integer cents.
  amountCents          Int
  frequencyUnit        FrequencyUnit
  frequencyInterval    Int            @default(1)
  /// Day of month (1–31) the schedule is anchored to, so month-end dates recover (31 → 28 → 31).
  anchorDay            Int
  /// "YYYY-MM-DD"
  startDate            String
  /// "YYYY-MM-DD" — due date of the current (open) cycle.
  nextDueDate          String
  /// JSON int[] of days relative to the due date (negative = after).
  reminderOffsets      Json
  /// Renews (and charges) automatically: triggers an AUTO_RENEW_NOTICE before the due date.
  autoRenew            Boolean        @default(false)
  /// A free trial; trialEndsOn ("YYYY-MM-DD") triggers TRIAL_ENDING reminders.
  isTrial              Boolean        @default(false)
  trialEndsOn          String?
  /// Pre-selected method when recording a payment.
  defaultPaymentMethod PaymentMethod?
  status               BillStatus     @default(ACTIVE)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payments      PaymentRecord[]
  notifications Notification[]
  priceChanges  PriceChange[]
  snoozes       ReminderSnooze[]

  @@index([workspaceId, nextDueDate])
  @@index([workspaceId, status])
  @@index([workspaceId, companyId])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, accountRefHash])
}

model PaymentRecord {
  id           String        @id @default(cuid())
  /// Denormalised for workspace-scoped queries and isolation checks.
  workspaceId  String
  billId       String
  /// "YYYY-MM-DD" — which cycle this payment belongs to.
  cycleDueDate String
  /// US dollars, integer cents.
  amountCents  Int
  /// "YYYY-MM-DD"
  paidOn       String
  method       PaymentMethod
  reference    String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId, cycleDueDate])
  @@index([workspaceId, paidOn])
  @@index([workspaceId, cycleDueDate])
}

model DeviceToken {
  id            String   @id @default(cuid())
  userId        String
  expoPushToken String   @unique
  platform      String
  lastSeenAt    DateTime @default(now())
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model NotificationPreference {
  userId         String
  workspaceId    String
  pushEnabled    Boolean  @default(true)
  emailEnabled   Boolean  @default(true)
  inAppEnabled   Boolean  @default(true)
  digestEnabled  Boolean  @default(true)
  weeklySummary  Boolean  @default(true)
  monthlySummary Boolean  @default(true)
  budgetAlerts   Boolean  @default(true)
  teamActivity   Boolean  @default(true)
  /// JSON string[] of bill ids the user muted.
  mutedBillIds   Json
  updatedAt      DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

model Notification {
  id           String              @id @default(cuid())
  workspaceId  String
  userId       String
  billId       String?
  type         NotificationType
  title        String
  body         String
  data         Json
  /// "YYYY-MM-DD"
  cycleDueDate String?
  offsetDays   Int?
  channel      NotificationChannel
  status       NotificationStatus  @default(PENDING)
  /// workspaceId:billId:type:cycleDueDate:offsetDays:userId:channel — unique so nothing is ever sent twice.
  dedupeKey    String              @unique
  attempts     Int                 @default(0)
  error        String?
  /// Not delivered before this instant (quiet hours).
  sendAfter    DateTime?
  /// Expo push ticket id, used to fetch the delivery receipt.
  pushTicketId String?
  readAt       DateTime?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill      Bill?     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, channel, createdAt])
  @@index([userId, workspaceId, channel, readAt])
  @@index([status, channel, sendAfter])
  @@index([billId, cycleDueDate])
}

/// Internal audit trail. Never shown in the app as ownership ("created by", "assigned to").
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  action      String
  entity      String
  entityId    String
  meta        Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([entity, entityId])
}

/// Marks that a workspace's reminders were processed for a local date.
/// The unique constraint makes the claim atomic across workers.
model WorkspaceReminderRun {
  id          String   @id @default(cuid())
  workspaceId String
  /// Workspace-local "YYYY-MM-DD".
  localDate   String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, localDate])
}

/// Database-backed job queue (DECISIONS.md D2).
model Job {
  id           String    @id @default(cuid())
  queue        String
  payload      Json
  status       JobStatus @default(PENDING)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  runAt        DateTime  @default(now())
  lockedAt     DateTime?
  lockedBy     String?
  lastError    String?
  /// Optional idempotency key: a second enqueue with the same key is ignored.
  singletonKey String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([queue, status, runAt])
}

/// Every change of a bill's amount, for the price history ("$40.00 → $48.00 on 3 Mar").
model PriceChange {
  id             String   @id @default(cuid())
  workspaceId    String
  billId         String
  oldAmountCents Int
  newAmountCents Int
  changedAt      DateTime @default(now())

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId, changedAt])
  @@index([workspaceId, changedAt])
}

/// Optional monthly budget for the whole workspace (categoryId null) or one category.
model Budget {
  id                String   @id @default(cuid())
  workspaceId       String
  /// Null = the whole workspace.
  categoryId        String?
  /// "all" or the category id, so (workspaceId, scope) is unique on every database (nulls never collide).
  scope             String
  monthlyLimitCents Int
  alertAtPercent    Int      @default(80)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, scope])
}

/// "Remind me later" for one cycle of one bill.
model ReminderSnooze {
  id           String   @id @default(cuid())
  userId       String
  billId       String
  /// "YYYY-MM-DD" cycle the snooze applies to.
  cycleDueDate String
  /// "YYYY-MM-DD" (workspace-local): reminders resume on this date.
  snoozedUntil String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([userId, billId, cycleDueDate])
}

/// "Send feedback" from Help & feedback.
model Feedback {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  message     String
  appVersion  String?
  platform    String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AiConversation {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([workspaceId, userId, updatedAt])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           AiRole
  text           String
  /// Cards (bills, totals, pending actions) shown with the reply.
  cards          Json
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback     AiFeedback[]

  @@index([conversationId, createdAt])
}

/// Facts a workspace taught DueOra AI ("we always pay by bank transfer").
model AiMemory {
  id          String   @id @default(cuid())
  workspaceId String
  text        String
  createdBy   String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AiFeedback {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  /// 1 = 👍, -1 = 👎
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  message AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model AiUsage {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  model        String
  inputTokens  Int
  outputTokens Int
  /// chat | insight | suggest
  kind         String
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
}

/// Cached daily dashboard insight (one per workspace and local date).
model AiInsight {
  id          String   @id @default(cuid())
  workspaceId String
  localDate   String
  text        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, localDate])
}
