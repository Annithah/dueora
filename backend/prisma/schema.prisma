// DueOra data model.
//
// Conventions (see DECISIONS.md D1 and D6):
// - Calendar dates without time (due dates, paid-on) are ISO strings "YYYY-MM-DD".
//   They sort correctly as text and can never be shifted by a timezone.
// - Money is always US dollars as integer cents (amountCents). Never floats, no other currency.
// - Every business table carries workspaceId; services always filter by it.
// - Json columns have no DB default (Prisma emits invalid SQLite for them); the
//   application always sets them (see src/db/defaults.ts).
// - This file targets SQLite. scripts/postgres-migration.mjs derives the optional
//   PostgreSQL schema from it.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

enum WorkspaceType {
  COMPANY
  PERSONAL
}

enum Role {
  ADMIN
  FINANCE
  VIEWER
}

enum FrequencyUnit {
  WEEK
  MONTH
  YEAR
  ONCE
}

enum SubscriptionStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  CASH
  OTHER
}

enum NotificationType {
  REMINDER
  DUE_TODAY
  OVERDUE
  PAYMENT_RECORDED
  DIGEST
  SYSTEM
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships       Membership[]
  refreshTokens     RefreshToken[]
  emailTokens       EmailToken[]
  deviceTokens      DeviceToken[]
  notificationPrefs NotificationPreference[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  invitesSent       Invite[]
}

model Workspace {
  id                     String        @id @default(cuid())
  name                   String
  type                   WorkspaceType @default(COMPANY)
  /// IANA timezone; "today" for this workspace is always computed here.
  timezone               String        @default("Africa/Kigali")
  /// Local hour (0–23) at which daily reminders go out.
  reminderHour           Int           @default(9)
  /// Quiet hours as minutes after local midnight (e.g. 1320 = 22:00). Both null = no quiet hours.
  quietHoursStart        Int?
  quietHoursEnd          Int?
  /// Default reminder offsets in days (JSON int[]; negative = after due date).
  defaultReminderOffsets Json
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  memberships       Membership[]
  companies         Company[]
  categories        Category[]
  subscriptions     Subscription[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  auditLogs         AuditLog[]
  invites           Invite[]
  reminderRuns      WorkspaceReminderRun[]
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(VIEWER)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(VIEWER)
  /// SHA-256 of the invite token sent by email.
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  /// SHA-256 of the opaque refresh token; the raw token is never stored.
  tokenHash    String    @unique
  /// All rotations of one login share a family; reuse of a rotated token revokes the family.
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  purpose   EmailTokenPurpose
  /// SHA-256 of the 6-digit code.
  codeHash  String
  attempts  Int               @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// A company inside a workspace (e.g. "KT Radio", "KigaliToday"). Every subscription belongs to one.
model Company {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  color       String    @default("#0F5C5C")
  /// Set when a company with subscriptions is "deleted": hidden from pickers, history kept.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([workspaceId, name])
}

model Category {
  id          String   @id @default(cuid())
  /// Null for the built-in defaults shared by every workspace.
  workspaceId String?
  name        String
  icon        String
  color       String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace     Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([workspaceId, name])
}

model Subscription {
  id                       String             @id @default(cuid())
  workspaceId              String
  companyId                String
  categoryId               String
  name                     String
  provider                 String?
  description              String?
  /// AES-256-GCM ciphertext of the subscription key (license key, account number, ...). See src/lib/secretBox.ts.
  subscriptionKeyEncrypted String?
  /// Last 4 characters, for the masked display "••••••4F7A".
  subscriptionKeyLast4     String?
  /// HMAC-SHA256 of the normalised key, for exact-match search without decrypting.
  subscriptionKeyHash      String?
  /// US dollars, integer cents.
  amountCents              Int
  frequencyUnit            FrequencyUnit
  frequencyInterval        Int                @default(1)
  /// Day of month (1–31) the schedule is anchored to, so month-end dates recover (31 → 28 → 31).
  anchorDay                Int
  /// "YYYY-MM-DD"
  startDate                String
  /// "YYYY-MM-DD" — due date of the current (open) cycle.
  nextDueDate              String
  /// JSON int[] of days relative to the due date (negative = after).
  reminderOffsets          Json
  status                   SubscriptionStatus @default(ACTIVE)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payments      PaymentRecord[]
  notifications Notification[]

  @@index([workspaceId, nextDueDate])
  @@index([workspaceId, status])
  @@index([workspaceId, companyId])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, subscriptionKeyHash])
}

model PaymentRecord {
  id             String        @id @default(cuid())
  /// Denormalised for workspace-scoped queries and isolation checks.
  workspaceId    String
  subscriptionId String
  /// "YYYY-MM-DD" — which cycle this payment belongs to.
  cycleDueDate   String
  /// US dollars, integer cents.
  amountCents    Int
  /// "YYYY-MM-DD"
  paidOn         String
  method         PaymentMethod
  reference      String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, cycleDueDate])
  @@index([workspaceId, paidOn])
  @@index([workspaceId, cycleDueDate])
}

model DeviceToken {
  id            String   @id @default(cuid())
  userId        String
  expoPushToken String   @unique
  platform      String
  lastSeenAt    DateTime @default(now())
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model NotificationPreference {
  userId               String
  workspaceId          String
  pushEnabled          Boolean  @default(true)
  emailEnabled         Boolean  @default(true)
  digestEnabled        Boolean  @default(true)
  /// JSON string[] of subscription ids the user muted.
  mutedSubscriptionIds Json
  updatedAt            DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

model Notification {
  id             String              @id @default(cuid())
  workspaceId    String
  userId         String
  subscriptionId String?
  type           NotificationType
  title          String
  body           String
  data           Json
  /// "YYYY-MM-DD"
  cycleDueDate   String?
  offsetDays     Int?
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  /// workspaceId:subscriptionId:cycleDueDate:offsetDays:userId:channel — unique so a reminder can never be sent twice.
  dedupeKey      String              @unique
  attempts       Int                 @default(0)
  error          String?
  /// Not delivered before this instant (quiet hours).
  sendAfter      DateTime?
  /// Expo push ticket id, used to fetch the delivery receipt.
  pushTicketId   String?
  readAt         DateTime?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, channel, createdAt])
  @@index([userId, workspaceId, channel, readAt])
  @@index([status, channel, sendAfter])
  @@index([subscriptionId, cycleDueDate])
}

/// Internal audit trail. Never shown in the app as ownership ("created by", "assigned to").
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  action      String
  entity      String
  entityId    String
  meta        Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([entity, entityId])
}

/// Marks that a workspace's reminders were processed for a local date.
/// The unique constraint makes the claim atomic across workers.
model WorkspaceReminderRun {
  id          String   @id @default(cuid())
  workspaceId String
  /// Workspace-local "YYYY-MM-DD".
  localDate   String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, localDate])
}

/// Database-backed job queue (DECISIONS.md D2).
model Job {
  id           String    @id @default(cuid())
  queue        String
  payload      Json
  status       JobStatus @default(PENDING)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  runAt        DateTime  @default(now())
  lockedAt     DateTime?
  lockedBy     String?
  lastError    String?
  /// Optional idempotency key: a second enqueue with the same key is ignored.
  singletonKey String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([queue, status, runAt])
}
