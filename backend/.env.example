# --- Server ---
NODE_ENV=development
PORT=4000
# Public base URL of the API (HTTPS in production)
API_BASE_URL=http://localhost:4000
# Deep-link scheme / web URL used in emails ("Open in DueOra")
APP_URL=dueora://

# --- Database ---
# SQLite everywhere (DECISIONS.md D14). Production: file:/data/dueora.db on a persistent disk.
# Optional Postgres build: DATABASE_URL=postgresql://user:password@host:5432/dueora?sslmode=require
DATABASE_URL=file:./dueora.db

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="DueOra <reminders@example.com>"

# --- Push (Expo) ---
# Optional: only needed if you enable "enhanced push security" in your Expo account
EXPO_ACCESS_TOKEN=

# --- Logging ---
LOG_LEVEL=info

# --- Subscription keys ---
# AES-256-GCM key material for subscription keys at rest (>= 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never change it once real data exists, or stored keys can no longer be decrypted.
SUBSCRIPTION_KEY_SECRET=

# --- DueOra AI (Google Gemini) — backend only, never in the app ---
# Leave empty to switch the assistant off (the rest of DueOra works the same).
GEMINI_API_KEY=
# The fast "Flash" model. Change when Google releases a newer one.
GEMINI_MODEL=gemini-2.5-flash
# Chat messages per user per hour.
AI_MESSAGES_PER_HOUR=30

# --- Error reporting (Sentry) — optional; empty = off ---
SENTRY_DSN=
