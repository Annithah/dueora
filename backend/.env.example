# --- Server ---
NODE_ENV=development
PORT=4000
# Public base URL of the API (HTTPS in production)
API_BASE_URL=http://localhost:4000
# Deep-link scheme / web URL used in emails ("Open in DueOra")
APP_URL=dueora://

# --- Database ---
# Development/tests use SQLite (see DECISIONS.md). Production uses Postgres:
#   DATABASE_URL=postgresql://user:password@host:5432/dueora?sslmode=require
DATABASE_URL=file:./dev.db

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="DueOra <reminders@example.com>"

# --- Push (Expo) ---
# Optional: only needed if you enable "enhanced push security" in your Expo account
EXPO_ACCESS_TOKEN=

# --- File storage ---
# local | s3  (s3 = any S3-compatible store, e.g. Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Demo seed (development only) ---
# Password for the demo users created by `npm run db:seed`. Leave empty to generate one.
SEED_ADMIN_PASSWORD=

# --- Logging ---
LOG_LEVEL=info
